# Copy this file to .env (same folder as server.js) and fill in ONE key.
# Never commit .env or share it.

# If you use DeepSeek:
DEEPSEEK_API_KEY=paste-your-deepseek-key-here

# If you use Anthropic instead, remove the line above and use this one:
# ANTHROPIC_API_KEY=paste-your-key-here

# Optional
# AI_PROVIDER=deepseek        (deepseek or anthropic; picked from the key if not set)
# AI_MODEL=deepseek-flash
# PORT=3000
