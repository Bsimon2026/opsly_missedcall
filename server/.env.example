# Copy this file to .env (same folder as server.js) and fill in the keys.
# Never commit .env or share it. Keys go here, never into a chat.

# ---- AI provider: fill in ONE ----
DEEPSEEK_API_KEY=paste-your-deepseek-key-here
# ANTHROPIC_API_KEY=paste-your-key-here

# ---- Database (Supabase) ----
SUPABASE_URL=https://smhqttottanaoilflqwf.supabase.co
# The secret key: Project Settings -> API Keys. Use the "secret" key (starts with sb_secret_)
# or the legacy "service_role" key. NEVER use the publishable/anon key here.
SUPABASE_SERVICE_KEY=paste-your-supabase-secret-key-here

# ---- Optional ----
# AI_PROVIDER=deepseek        (deepseek or anthropic; picked from the key if not set)
# AI_MODEL=deepseek-flash
# PORT=3000
# FORCE_MEMORY_STORE=1        (ignore Supabase and use the sample data in memory)
